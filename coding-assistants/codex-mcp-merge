#!/usr/bin/env python3
"""Merge MCP servers into Codex's config.toml without touching anything else in the file.

Usage: codex-mcp-merge CONFIG_TOML < servers.json
stdin: one JSON object mapping server name -> {"url": ...} or {"command", "args", "env"}.

Only [mcp_servers.NAME] tables that do not exist yet are appended (existing entries, user settings and comments stay
byte-identical). Nothing is written when the file cannot be parsed. Entry contents may carry secrets and are never
printed, only counts. Exit codes: 0 ok, 1 error (file untouched).
"""

import json
import os
import re
import sys
import tempfile
import tomllib
from pathlib import Path

BARE_KEY = re.compile(r"^[A-Za-z0-9_-]+$")


def key(name: str) -> str:
    return name if BARE_KEY.match(name) else json.dumps(name)


def string(value: str) -> str:
    # JSON string escaping is valid TOML basic-string escaping for everything except lone surrogates
    return json.dumps(str(value), ensure_ascii=False)


def render(name: str, entry: dict) -> str:
    head = f"[mcp_servers.{key(name)}]"
    lines = [head]
    if entry.get("url"):
        lines.append(f"url = {string(entry['url'])}")
    else:
        lines.append(f"command = {string(entry['command'])}")
        lines.append("args = [" + ", ".join(string(a) for a in entry.get("args") or []) + "]")
    env = entry.get("env") or {}
    if env:
        lines.append(f"\n[mcp_servers.{key(name)}.env]")
        lines.extend(f"{key(k)} = {string(v)}" for k, v in env.items())
    return "\n".join(lines) + "\n"


def merge(config: Path, servers: dict) -> tuple[int, int]:
    text = config.read_text(encoding="utf-8") if config.exists() else ""
    existing = tomllib.loads(text).get("mcp_servers", {})
    blocks = [render(n, e) for n, e in servers.items() if n not in existing]
    if not blocks:
        return 0, len(servers)
    new_text = text
    if new_text and not new_text.endswith("\n"):
        new_text += "\n"
    if new_text:
        new_text += "\n"
    new_text += "\n".join(blocks)
    parsed = tomllib.loads(new_text)  # never write something we cannot read back
    for name in (n for n in servers if n not in existing):
        if name not in parsed.get("mcp_servers", {}):
            raise ValueError("rendered config lost an entry")
    fd, tmp = tempfile.mkstemp(dir=config.parent, prefix=".config.toml.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(new_text)
        os.chmod(tmp, config.stat().st_mode & 0o777 if config.exists() else 0o600)
        os.replace(tmp, config)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    return len(blocks), len(servers) - len(blocks)


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: codex-mcp-merge CONFIG_TOML < servers.json", file=sys.stderr)
        return 1
    try:
        servers = json.load(sys.stdin)
        if not isinstance(servers, dict):
            raise ValueError("stdin must be a JSON object")
        added, kept = merge(Path(sys.argv[1]), servers)
    except Exception as exc:  # noqa: BLE001 - message only, never entry contents
        print(f"codex-mcp-merge: {type(exc).__name__}: leaving {sys.argv[1]} untouched", file=sys.stderr)
        return 1
    print(f"added {added}, kept {kept}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
