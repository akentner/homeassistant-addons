#!/usr/bin/env python3
# Home Assistant Repairs Checker
# Displays all pending repairs/issues

import json
import subprocess
import sys

def main():
    show_ignored = len(sys.argv) > 1 and sys.argv[1] == 'true'

    print("🔧 Home Assistant Repairs/Issues")
    print()

    # Get repairs via ha-ws
    try:
        result = subprocess.run(['ha-ws', 'raw', 'repairs/list_issues'],
                              capture_output=True, text=True, check=True)
        data = json.loads(result.stdout)
    except Exception as e:
        print(f"❌ Error fetching repairs: {e}")
        sys.exit(1)

    if not data.get('success'):
        print("❌ Error fetching repairs")
        sys.exit(1)

    issues = data['result']['issues']

    # Filter ignored if needed
    if not show_ignored:
        issues = [i for i in issues if not i.get('ignored', False)]

    # Count by severity
    errors = [i for i in issues if i['severity'] == 'error']
    warnings = [i for i in issues if i['severity'] == 'warning']

    print(f"📊 Summary: {len(errors)} Errors, {len(warnings)} Warnings")
    print()

    # Show errors first
    if errors:
        print("🔴 ERRORS (need attention):")
        for issue in errors:
            domain = issue.get('issue_domain') or issue.get('domain')
            print(f"\n  • {domain}: {issue.get('issue_id')}")

            placeholders = issue.get('translation_placeholders', {})
            if 'name' in placeholders:
                print(f"    Name: {placeholders['name']}")
            if 'automation' in placeholders:
                print(f"    Automation: {placeholders['automation']}")

            print(f"    Fixable: {'Yes' if issue.get('is_fixable') else 'No'}")
            print(f"    Created: {issue['created'][:10]}")

    # Show warnings
    if warnings:
        print("\n⚠️  WARNINGS:")

        # Group by issue_domain
        by_domain = {}
        for issue in warnings:
            domain = issue.get('issue_domain') or issue.get('domain')
            if domain not in by_domain:
                by_domain[domain] = []
            by_domain[domain].append(issue)

        for domain, domain_issues in sorted(by_domain.items()):
            print(f"\n  {domain.upper()} ({len(domain_issues)} issues):")
            for issue in domain_issues:
                placeholders = issue.get('translation_placeholders', {})

                # Extract main info
                name = (placeholders.get('automation') or
                       placeholders.get('scene') or
                       placeholders.get('dashboard') or
                       issue['issue_id'])

                print(f"    • {name}")

                # Show missing entities/services
                if 'entities' in placeholders:
                    entities = placeholders['entities'].split('\n')[:3]  # First 3
                    for ent in entities:
                        if ent.strip():
                            print(f"      {ent}")
                    if len(placeholders['entities'].split('\n')) > 3:
                        print(f"      ... and more")

                if 'services' in placeholders:
                    services = placeholders['services'].split('\n')
                    for svc in services:
                        if svc.strip():
                            print(f"      {svc}")

    print()
    print("💡 Usage:")
    print("  ha-check-repairs          # Show active issues")
    print("  ha-check-repairs true     # Show all (including ignored)")

if __name__ == '__main__':
    main()
