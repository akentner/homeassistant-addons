{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": false,
  "commitMessageAction": "update",
  "commitMessageExtra": "to {{newVersion}}",
  "commitMessagePrefix": "chore:",
  "commitMessageTopic": "{{depName}}",
  "customManagers": [
    {
      "autoReplaceStringTemplate": "version: \"{{newValue}}-0\"",
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "akentner/phone-logger",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "fileMatch": [
        "^phone-logger/config\\.yaml$"
      ],
      "matchStrings": [
        "version:\\s+\"(?<currentValue>[^-\"]+)-\\d+\""
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "akentner/phone-logger",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "fileMatch": [
        "^phone-logger/build\\.yaml$"
      ],
      "matchStrings": [
        "VERSION:\\s+\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "semver"
    }
  ],
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "additionalBranchPrefix": "phone-logger-",
      "groupName": "phone-logger",
      "matchDepNames": [
        "akentner/phone-logger"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "semanticCommits": "enabled"
    },
    {
      "enabled": false,
      "matchDepNames": [
        "python",
        "node"
      ],
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "allowedVersions": "3.13",
      "description": "litellm builder must match the python3.13 of the Debian trixie runtime stage",
      "matchDepNames": [
        "python"
      ],
      "matchFileNames": [
        "litellm/Dockerfile"
      ],
      "matchManagers": [
        "dockerfile"
      ]
    }
  ],
  "platformAutomerge": false,
  "schedule": [
    "at any time"
  ],
  "timezone": "Europe/Berlin"
}
