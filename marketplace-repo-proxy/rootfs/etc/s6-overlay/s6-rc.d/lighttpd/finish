#!/bin/sh
# Take the container down when lighttpd fails, so HA shows the add-on as stopped (community finish pattern).
# s6 passes the service exit code ($1, 256 = killed by a signal) and the signal number ($2).
results=/run/s6-linux-init-container-results/exitcode
exit_code_container=$(cat "${results}" 2>/dev/null || echo 0)
exit_code_service="${1:-0}"
exit_code_signal="${2:-0}"
if [ "${exit_code_service}" -eq 256 ]; then
  if [ "${exit_code_container}" -eq 0 ]; then echo $((128 + exit_code_signal)) > "${results}"; fi
  if [ "${exit_code_signal}" -eq 15 ]; then exec /run/s6/basedir/bin/halt; fi
elif [ "${exit_code_service}" -ne 0 ]; then
  if [ "${exit_code_container}" -eq 0 ]; then echo "${exit_code_service}" > "${results}"; fi
  exec /run/s6/basedir/bin/halt
fi
